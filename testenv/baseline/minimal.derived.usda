            uniform token aeco:derived:role = "axis"
            string aeco:derived:source = "b9000000-0000-4000-8000-000000000002"
            string aeco:derived:stamp = "aeco-axis 0.1.3"
            double aeco:derived:tolerance = 1e-9
            int[] curveVertexCounts = [2]
            float3[] extent = [(-0.03, -0.03, -0.03), (0.03, 2.03, 0.03)]
            point3f[] points = [(0, 0, 0), (0, 2, 0)]
            color3f[] primvars:displayColor = [(0.12, 0.58, 0.88)]
            uniform token purpose = "guide"
            uniform token type = "linear"
            float[] widths = [0.06] (
                interpolation = "constant"
            )
            uniform token wrap = "nonperiodic"
        }
    }

    def "Pipe3"
    {
        double aeco:axis:length = 2

        def BasisCurves "Axis" (
            prepend apiSchemas = ["AecoDerivedGeometryAPI"]
        )
        {
            uniform token aeco:derived:approx = "exact"
            uniform token aeco:derived:role = "axis"
            string aeco:derived:source = "b9000000-0000-4000-8000-000000000003"
            string aeco:derived:stamp = "aeco-axis 0.1.3"
            double aeco:derived:tolerance = 1e-9
            int[] curveVertexCounts = [2]
            float3[] extent = [(-0.03, -0.03, -0.03), (0.03, 0.03, 2.03)]
            point3f[] points = [(0, 0, 0), (0, 0, 2)]
            color3f[] primvars:displayColor = [(0.12, 0.58, 0.88)]
            uniform token purpose = "guide"
            uniform token type = "linear"
            float[] widths = [0.06] (
                interpolation = "constant"
            )
            uniform token wrap = "nonperiodic"
        }
    }
